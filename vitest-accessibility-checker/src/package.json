{
  "name": "vitest-accessibility-checker",
  "version": "3.0.0",
  "description": "Accessibility Checker for Vitest",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./commands": "./commands.js",
    "./matchers": {
      "types": "./matchers.d.ts",
      "default": "./matchers.js"
    }
  },
  "scripts": {
